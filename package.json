{
  "name": "@kikiutils/stylelint-config",
  "type": "module",
  "version": "0.4.1",
  "description": "",
  "author": "kiki-kanri",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kikiutils/stylelint-config.git"
  },
  "keywords": [],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": null
    },
    "./index": {
      "types": null,
      "import": null,
      "require": null
    },
    "./package.json": "./package.json",
    "./*": "./dist/*.js"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "./dist",
    "./src"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsdown",
    "bumplog": "changelogen --bump --hideAuthorEmail",
    "knip:deps": "knip --dependencies",
    "knip:exports": "knip --exports",
    "lint": "eslint --max-warnings 0",
    "lint:fix": "eslint --fix --max-warnings 0",
    "prepack": "pnpm run build",
    "release": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build && changelogen --hideAuthorEmail --push --release && npm publish",
    "test": "vitest run --coverage",
    "test:watch": "vitest watch --coverage",
    "typecheck": "tsc -b --noEmit"
  },
  "peerDependenciesMeta": {},
  "dependencies": {
    "es-toolkit": "^1.49.0",
    "stylelint": "^17.14.0",
    "stylelint-config-clean-order": "^10.0.0",
    "stylelint-config-html": "^1.1.0",
    "stylelint-config-recommended-vue": "^1.6.1",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-declaration-block-no-ignored-properties": "^3.0.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.1.0",
    "@kikiutils/eslint-config": "^9.2.0",
    "@kikiutils/tsconfigs": "^7.0.0",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "changelogen": "^0.6.2",
    "eslint": "^10.7.0",
    "knip": "^6.27.0",
    "publint": "^0.3.21",
    "tsdown": "^0.22.9",
    "typescript": "^6.0.3",
    "unplugin-unused": "^0.5.7",
    "vitest": "^4.1.10"
  }
}
