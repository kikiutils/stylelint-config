{
  "name": "@kikiutils/stylelint-config",
  "type": "module",
  "version": "0.7.0",
  "description": "",
  "author": "kiki-kanri",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kikiutils/stylelint-config.git"
  },
  "keywords": [],
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "./dist",
    "./src"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsdown",
    "bumplog": "changelogen --bump --hideAuthorEmail",
    "knip:deps": "knip --dependencies",
    "knip:exports": "knip --exports",
    "lint": "eslint --cache --concurrency=auto --max-warnings 0",
    "lint:fix": "eslint --cache --concurrency=auto --fix --max-warnings 0",
    "prepack": "pnpm run build",
    "release": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build && changelogen --clean --hideAuthorEmail --push --release && npm publish",
    "test": "vitest run --coverage",
    "test:watch": "vitest watch --coverage",
    "typecheck": "tsc -b --noEmit"
  },
  "peerDependencies": {
    "stylelint": "^18.0.0"
  },
  "peerDependenciesMeta": {},
  "dependencies": {
    "es-toolkit": "^1.53.2",
    "stylelint-config-clean-order": "^10.0.0",
    "stylelint-config-html": "^2.0.0",
    "stylelint-config-recommended-vue": "^2.0.0",
    "stylelint-config-standard-scss": "^18.0.0",
    "stylelint-declaration-block-no-ignored-properties": "^3.1.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@arethetypeswrong/core": "^0.18.5",
    "@kikiutils/eslint-config": "^11.2.1",
    "@kikiutils/tsconfigs": "^7.0.0",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.1",
    "changelogen": "^0.6.2",
    "eslint": "^10.15.0",
    "knip": "^6.48.0",
    "publint": "^0.3.25",
    "ts-extras": "^3.0.0",
    "tsdown": "^0.23.7",
    "typescript": "^6.0.3",
    "unplugin-unused": "^0.6.0",
    "vitest": "^5.1.1"
  }
}
